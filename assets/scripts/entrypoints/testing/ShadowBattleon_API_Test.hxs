// ShadowBattleon farm with non-blocking probes for the API's state and action-result additions.
// The farm flow starts immediately; diagnostic callback results must not gate questing or combat.

var questIds = [9421, 9422, 9423];
var checkedCompletions = [];
var farmStarted = false;

function reportResult(label, result) {
    var state = result.success ? "SUCCESS" : result.status.toUpperCase();
    log("[API test] " + label + " => " + state + " (" + result.elapsedMs + "ms): " + result.message);
}

function startFarm() {
    if (farmStarted) return;
    farmStarted = true;
    log("[API test] Starting ShadowBattleon leveling quests.");
    acceptAllDrops();
    if (!equipLoadout("farm")) log("[API test] Could not select the configured farm loadout.");
    autoQuest(questIds);
}

function onStart() {
    log("[API test] Starting ShadowBattleon API test.");
    checkedCompletions = [];

    var domains = ["player", "target", "auras", "inventory", "quests", "map"];
    for (domain in domains) {
        var health = stateHealth.get(domain, 30000);
        log("[API test] state " + domain + ": " + health.status +
            ", available=" + health.available + ", ageMs=" + health.ageMs);
    }

    // Start the known farm flow before probing callbacks. A delayed or timed-out result must
    // not prevent autoQuest or combat from running.
    startFarm();

    map.joinWithResult("shadowbattleon", "Enter", "Spawn", function(joinResult) {
        reportResult("join shadowbattleon", joinResult);
        if (joinResult.success) {
            map.jumpWithResult("Enter", "Spawn", function(jumpResult) {
                reportResult("confirm ShadowBattleon spawn cell", jumpResult);
            }, 15000);
        }
    }, 30000);

}

function onQuestUpdated(data) {
    // autoQuest performs the actual turn-in. Once completion is reflected in live state, use
    // the result-bearing method to verify it sees the completed quest without another turn-in.
    for (qid in questIds) {
        if (checkedCompletions.indexOf(qid) >= 0 || !quests.isCompleted(qid)) continue;
        checkedCompletions.push(qid);
        quests.completeWithResult(qid, -1, function(result) {
            reportResult("observe completed quest " + qid, result);
        }, 1000);
    }
}

function onTick() {
    if (!farmStarted) return;
    ensureMap("shadowbattleon", "Enter", "Spawn");
    hunt("Doomed Troll");
}

function onStop() {
    log("[API test] ShadowBattleon API test stopped.");
    stopAutoQuest();
    stopCombat();
}
