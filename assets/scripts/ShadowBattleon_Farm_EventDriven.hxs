// ShadowBattleon farm used to exercise the HScript lifecycle and deferred event model.
//
// This intentionally keeps the farm simple: the API owns combat and quest automation while the
// script observes state through callbacks. It is useful for verifying that callbacks do not run
// re-entrantly while map/combat actions are being executed.

var shadowMap = "shadowbattleon";
var shadowCell = "Enter";
var shadowPad = "Spawn";
var shadowMonster = "Doomed Troll";
var shadowQuests = [9421, 9422, 9423];

var farmActive = false;
var zoneEvents = 0;
var combatEvents = 0;
var questEvents = 0;
var packetEvents = 0;

function onStart() {
    log("[ShadowBattleon] event-driven farm started.");
    farmActive = true;
    zoneEvents = 0;
    combatEvents = 0;
    questEvents = 0;
    packetEvents = 0;

    acceptAllDrops();
    if (!equipLoadout("farm")) {
        log("[ShadowBattleon] farm loadout was not available; continuing with the current class.");
    }

    autoQuest(shadowQuests);
    ensureMap(shadowMap, shadowCell, shadowPad);
    sleep(500);
}

function onTick() {
    if (!farmActive) return;

    // The watchdog is only a recovery path. Map/combat managers remain responsible for the actual
    // action timing, so this does not send a new request on every scheduler tick.
    if (!isLoaded() || mapName() != shadowMap) {
        ensureMap(shadowMap, shadowCell, shadowPad);
        sleep(500);
        return;
    }

    if (!isCell(shadowCell)) {
        ensureCell(shadowCell, shadowPad);
        sleep(250);
        return;
    }

    if (!isInCombat()) {
        hunt(shadowMonster);
        sleep(500);
    }
}

function onZoneEntered(data) {
    zoneEvents++;
    log("[ShadowBattleon] zone event #" + zoneEvents + ": " + shadowMap);
    sleep(250);
}

function onCombatUpdated(data) {
    combatEvents++;
    // Combat updates are coalesced by the engine. Log occasionally so the test does not flood chat.
    if (combatEvents % 25 == 0) {
        log("[ShadowBattleon] combat updates observed: " + combatEvents);
    }
}

function onQuestUpdated(data) {
    questEvents++;
    if (questEvents % 5 == 0) {
        log("[ShadowBattleon] quest events observed: " + questEvents);
    }
}

function onPacket(type, cmd, data) {
    packetEvents++;
    // Keep packet handling lightweight; this confirms ordered packet callbacks without affecting
    // the combat loop.
    if (packetEvents % 50 == 0) {
        log("[ShadowBattleon] packet callbacks observed: " + packetEvents);
    }
}

function onStop() {
    farmActive = false;
    stopAutoQuest();
    stopCombat();
    log("[ShadowBattleon] stopped. zones=" + zoneEvents
        + ", combat=" + combatEvents
        + ", quests=" + questEvents
        + ", packets=" + packetEvents);
}
