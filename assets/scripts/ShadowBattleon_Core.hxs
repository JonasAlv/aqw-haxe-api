// ShadowBattleon story progression using the API core orchestration layer.
//
// This follows the verified Shadow of Doom quest chain:
//   9422 Mega Shadow Hunt Medal  - Doomed Beast
//   9423 Early Autopsy           - Doomed Beast
//   9424 Given Life and Purpose  - Possessed Armor
//   9425 Adult Hatchling         - Ouro Spawn
//   9426 Solidified Light        - Tainted Wraith
//   9427 Enigmatic Entity        - Mysterious Stranger
//
// The workflow is intentionally small and goal-oriented:
//   - core.context owns the script policy
//   - core.travel handles map/cell navigation
//   - core.recovery handles death/health checks
//   - core.story coordinates hunting and quest progression
//   - core.combat delegates native targeting, skill timing, and validation
var mapName = "shadowbattleon";
var questIds = [9422, 9423, 9424, 9425, 9426, 9427];
var questMonsters = [
    "Doomed Beast",
    "Doomed Beast",
    "Possessed Armor",
    "Ouro Spawn",
    "Tainted Wraith",
    "Mysterious Stranger"
];

var finished = false;
var step = 0;
var lastStatusAt = 0;

function onStart() {
    finished = false;
    step = 0;
    lastStatusAt = 0;

    core.context.privateRooms = true;
    core.context.privateRoomNumber = 100000;
    core.context.autoRecover = true;

    core.drops.acceptAll(true);

    log("[ShadowBattleon Core] started: Shadowbattleon story quests");
}

function onTick() {
    if (finished || core.context.isStopped()) return;
    if (!core.context.isReady()) return;

    if (!core.recovery.maintain()) return;

    while (step < questIds.length && core.quest.isDone(questIds[step])) {
        step++;
    }

    if (step >= questIds.length) {
        finish("all Shadowbattleon quests are complete");
        return;
    }

    var questId = questIds[step];
    var monster = questMonsters[step];

    // Non-blocking: this joins Shadowbattleon, locates the monster's cell,
    // starts native combat, and completes the quest when its requirements are met.
    if (core.story.killQuest(questId, monster, mapName)) {
        log("[ShadowBattleon Core] completed quest " + questId + " (" + monster + ")");
        step++;
        return;
    }

    var now = core.context.now();
    if (now - lastStatusAt >= 5000) {
        lastStatusAt = now;
        log("[ShadowBattleon Core] quest " + questId + ": hunting " + monster);
    }
}

function finish(reason) {
    if (finished) return;
    finished = true;
    core.combat.stop();
    core.target.clear();
    log("[ShadowBattleon Core] complete: " + reason);
    stop();
}

function onStop() {
    finished = true;
    core.combat.stop();
    core.target.clear();
    log("[ShadowBattleon Core] stopped");
}
