// Grimgaol Dungeon Automation Script
// 12-Cell Sequential Dungeon Progression with Boss Counter-Mechanics
// Uses high-level HScriptEngine shortcuts on top of com.aqwapi Core

var dailyQuestId = 9469;
var dungeonQuests = [9467, 9466, 9468];
var clearItem = "Grimskull's Gaol Cleared";
var allDrops = ["Grimskull's Gaol Cleared", "Traitorous Skull", "Grimskull Trolling Rep"];

var currentClass = "Generic";
var rotationIndex = 0;
var runCount = 0;
var questsAttempted = false;
var grimskullEngaged = false;
var grimskullDefeated = false;
var lastVisitedCell = "";
var lastCombatCell = "Enter";

function onStart() {
    questsAttempted = false;
    grimskullEngaged = false;
    grimskullDefeated = false;
    lastVisitedCell = "";
    lastCombatCell = "Enter";
    rotationIndex = 0;

    log("==========================================");
    log("  GRIMGAOL 12-CELL DUNGEON RUNNER STARTED ");
    log("==========================================");

    // Pre-load all quests into memory
    loadQuests([dailyQuestId, 9467, 9466, 9468]);

    // Class selection (King's Echo is Skua's #1 recommended class for Grimgaol)
    if (hasItem("King's Echo")) {
        currentClass = "King's Echo";
        equip("King's Echo");
    } else if (hasItem("Dragon of Time")) {
        currentClass = "Dragon of Time";
        equip("Dragon of Time");
    } else if (hasItem("Legion Revenant")) {
        currentClass = "Legion Revenant";
        equip("Legion Revenant");
    } else if (hasItem("ArchPaladin")) {
        currentClass = "ArchPaladin";
        equip("ArchPaladin");
    } else {
        currentClass = "Generic";
    }

    log("Equipped Class: " + currentClass);
    setInfiniteRange(true);
    setDeathSpawn(true);

    if (map.name.toLowerCase() != "grimgaol") {
        log("Queueing for Grimgaol dungeon...");
        dungeonQueue("grimgaol");
        sleep(2500);
    }
}

function getNextCell(cell) {
    if (cell == "Enter") return "r2";
    if (cell == "r2") return "r3";
    if (cell == "r3") return "r4";
    if (cell == "r4") return "r5";
    if (cell == "r5") return "r6";
    if (cell == "r6") return "r7";
    if (cell == "r7") return "r8";
    if (cell == "r8") return "r9";
    if (cell == "r9") return "r10";
    if (cell == "r10") return "r11";
    if (cell == "r11") return "r12";
    if (cell == "r12") return "r12a";
    return "r12a";
}

function onTick() {
    if (!map.isLoaded) {
        sleep(500);
        return;
    }

    skipCutscene();

    if (isDead()) {
        log("Player defeated, waiting for respawn...");
        rotationIndex = 0;
        sleep(2000);
        return;
    }

    // Outside Grimgaol: turn in previous run, accept quests, re-queue
    if (map.name.toLowerCase() != "grimgaol") {
        grimskullEngaged = false;
        grimskullDefeated = false;
        lastVisitedCell = "";
        lastCombatCell = "Enter";

        if (hasItem(clearItem)) {
            completeQuests([9466, 9467, 9468, dailyQuestId]);
            getDrops(allDrops);
            runCount = runCount + 1;
            log("Runs completed: " + runCount);
            sleep(1000);
        }

        var slotVal = getQuestValue(530);
        var firstTimeCleared = hasBeenCompleted(9466) || slotVal >= 4;

        if (!firstTimeCleared) {
            if (!isQuestAccepted(9466) && isQuestAvailable(9466)) {
                log("[Gaol] Accepting First-Time Clear Quest 9466...");
                acceptQuest(9466);
                sleep(350);
            }
        } else {
            var rerunQuestId = isQuestAvailable(9468) ? 9468 : 9467;
            if (!isQuestAccepted(rerunQuestId) && isQuestAvailable(rerunQuestId)) {
                acceptQuest(rerunQuestId);
                sleep(350);
            }
            if (!isDailyComplete(dailyQuestId) && !isQuestAccepted(dailyQuestId) && isQuestAvailable(dailyQuestId)) {
                acceptQuest(dailyQuestId);
                sleep(350);
            }
        }

        log("Queueing into Grimgaol dungeon...");
        dungeonQueue("grimgaol");
        sleep(2500);
        return;
    }

    var currentCell = player.cell;

    // Cutscene bypass
    if (currentCell.toLowerCase().indexOf("cut") != -1) {
        jump("Enter", "Spawn");
        sleep(1000);
        return;
    }

    // Dungeon Completion in r12a
    if (currentCell == "r12a") {
        log("==========================================");
        log("Grimgaol Cleared! Collecting drops & turn-ins...");
        log("==========================================");
        getDrops(allDrops);
        completeQuests(dungeonQuests);
        completeQuest(dailyQuestId);
        runCount = runCount + 1;
        questsAttempted = false;
        grimskullEngaged = false;
        grimskullDefeated = false;
        lastVisitedCell = "";
        lastCombatCell = "Enter";
        log("Total Grimgaol Runs Complete: " + runCount);

        join("whitemap-100000");
        sleep(2000);
        return;
    }

    // Attempt quest acceptance once per run in Enter
    if (currentCell == "Enter" && !questsAttempted) {
        questsAttempted = true;
        if (!isQuestAccepted(dailyQuestId) && isQuestAvailable(dailyQuestId)) acceptQuest(dailyQuestId);
        for (q in dungeonQuests) {
            if (!isQuestAccepted(q) && isQuestAvailable(q)) acceptQuest(q);
        }
    }

    // Cell entry settling (ensures Flash memory has loaded room monsters)
    if (currentCell != lastVisitedCell) {
        lastVisitedCell = currentCell;
        log("Entered room [" + currentCell + "]. Settling...");
        setSpawnPoint(currentCell, "Left");
        sleep(800);
        return;
    }

    executeCellCombat(currentCell);
}

function executeCellCombat(cell) {
    // Room 1 (Enter) Grimskull special progression
    if (cell == "Enter") {
        if (isRoomClear("Enter")) {
            if (grimskullEngaged && !grimskullDefeated) {
                grimskullDefeated = true;
                log("SUCCESS! Grimskull defeated in Enter!");
                log("Room 1 clear! Advancing to Room 2 (r2)...");
                lastCombatCell = "r2";
                jump("r2", "Left");
                sleep(1000);
                return;
            } else if (!grimskullEngaged && !grimskullDefeated) {
                log("Enter cell is empty (stale instance). Queueing fresh run...");
                join("battleon");
                sleep(1500);
                return;
            } else if (grimskullDefeated) {
                var targetCell = (lastCombatCell != "" && lastCombatCell != "Enter") ? lastCombatCell : "r2";
                log("Respawned at Enter (Grimskull already dead). Advancing to: " + targetCell);
                jump(targetCell, "Left");
                sleep(1000);
                return;
            }
        }
    }

    // Room cleared check for all cells
    if (isRoomClear(cell)) {
        var next = getNextCell(cell);
        log("Cleared room " + cell + "! Advancing to " + next + "...");
        lastCombatCell = next;
        jump(next, "Left");
        sleep(1000);
        return;
    }

    lastCombatCell = cell;

    // Boss Counter-Mechanic: Talon Twisting Reflect Shield (Enter & r12)
    if (cell == "Enter" || cell == "r12") {
        var mon = getFirstMonster(cell);
        var hasTalon = (mon != null && mon.hasAura("Talon Twisting")) || hasAura("Talon Twisting");
        var hasRetaliate = (mon != null && mon.hasAura("Retaliate")) || hasAura("Retaliate");
        if (hasTalon && !hasRetaliate) {
            pauseCombat();
            log("REFLECT SHIELD (Talon Twisting) active! Pausing combat until Retaliate...");
            sleep(1000);
            return;
        }
    }

    // Room 10 Mechro Lich priority targeting
    if (cell == "r10") {
        handleRoom10Target();
    } else {
        if (player.target == null || !player.target.alive) {
            var mon = getFirstMonster(cell);
            if (mon != null) {
                log("Target acquired: " + mon.name + " (MapID: " + mon.mapId + ", HP: " + mon.hp + ")");
                attackTarget(mon);
                if (cell == "Enter") grimskullEngaged = true;
                sleep(250);
                return;
            }
        }
    }

    // Boss Counter-Mechanic: Empress Angler Execute (r3)
    if (cell == "r3") {
        if (targetHasAura("Concealed Blade") && !targetHasAura("Bottom Feeder")) {
            log("EXECUTE DETECTED (Concealed Blade)! Emergency defense prioritized!");
            if (canUseSkill(2)) useSkill(2);
            else if (canUseSkill(3)) useSkill(3);
            sleep(250);
            return;
        }
    }

    fireClassSkills(cell);
    sleep(150);
}

function handleRoom10Target() {
    var mon16 = monsters.findByMapId("16", true);
    if (mon16 != null && mon16.alive && mon16.hp > 70000) {
        if (player.target == null || player.target.mapId != "16") {
            log("[Room 10] Targeting Mechro Lich (16) HP: " + mon16.hp);
            attackTarget("16");
        }
        return;
    }

    var mon17 = monsters.findByMapId("17", true);
    if (mon17 != null && mon17.alive && mon17.hp > 50000) {
        if (player.target == null || player.target.mapId != "17") {
            log("[Room 10] Threshold reached. Targeting Mechro Lich (17) HP: " + mon17.hp);
            attackTarget("17");
        }
        return;
    }

    var mon18 = monsters.findByMapId("18", true);
    if (mon18 != null && mon18.alive && mon18.hp > 20000) {
        if (player.target == null || player.target.mapId != "18") {
            log("[Room 10] Threshold reached. Targeting Mechro Lich (18) HP: " + mon18.hp);
            attackTarget("18");
        }
        return;
    }

    if (player.target == null || !player.target.alive) {
        var mon = getFirstMonster("r10");
        if (mon != null) {
            log("[Room 10] Cleaning up: " + mon.name + " (MapID: " + mon.mapId + ")");
            attackTarget(mon);
        }
    }
}

function fireClassSkills(cell) {
    var hasContrarium = (cell == "Enter" || cell == "r12") && playerHasAura("Contrarium");

    var rot = [1, 2, 3, 4];
    if (currentClass == "Dragon of Time") rot = [3, 2, 1, 2, 4, 2];
    else if (currentClass == "Legion Revenant") rot = [3, 4, 1, 2];
    else if (currentClass == "King's Echo") rot = [1, 2];

    if (currentClass == "King's Echo") {
        if (mpPercent() <= 0.25 && canUseSkill(4)) {
            useSkill(4);
            sleep(150);
            return;
        }
        if (hpPercent() <= 0.65 && !hasContrarium && canUseSkill(3)) {
            useSkill(3);
            sleep(150);
            return;
        }
    }

    var skill = rot[rotationIndex];

    if (hasContrarium && (skill == 2 || skill == 3)) {
        rotationIndex = (rotationIndex + 1) % rot.length;
        skill = rot[rotationIndex];
    }

    if (canUseSkill(skill)) {
        useSkill(skill);
        rotationIndex = (rotationIndex + 1) % rot.length;
    } else {
        for (i in 0...rot.length) {
            var candidate = rot[i];
            if (hasContrarium && (candidate == 2 || candidate == 3)) continue;
            if (canUseSkill(candidate)) {
                useSkill(candidate);
                break;
            }
        }
    }
}

function onStop() {
    log("Grimgaol Runner stopped.");
    setInfiniteRange(false);
    dropCombat();
}
