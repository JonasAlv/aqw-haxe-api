// Grimgaol Prerequisites & Quest Unlock Diagnostic Script
// Checks player level, DoomVaultB, Forge Smite, Boulder quest chain (Slot 530),
// and Grimgaol quest availability.

function onStart() {
    log("=================================================");
    log("  GRIMGAOL PREREQUISITE & QUEST UNLOCK CHECKER   ");
    log("=================================================");

    // Pre-load all relevant quests into memory
    loadQuests([3004, 8740, 9463, 9464, 9465, 9466, 9467, 9468, 9469]);
    sleep(1200);

    // 1. Level Check
    var pLevel = player.level;
    var levelOk = pLevel >= 80;
    log("[Check 1] Player Level: " + pLevel + " / 80 required -> " + (levelOk ? "PASS [OK]" : "FAIL [Need Level 80]"));

    // 2. DoomVaultB Storyline Check (Quest 3004)
    var dvbDone = hasBeenCompleted(3004);
    log("[Check 2] DoomVaultB Story (Quest 3004): " + (dvbDone ? "COMPLETED [OK]" : "INCOMPLETE [Need DoomVaultB]"));

    // 3. Forge Smite Enhancement Check (Quest 8740)
    var smiteDone = hasBeenCompleted(8740);
    log("[Check 3] Forge Smite Unlocked (Quest 8740): " + (smiteDone ? "COMPLETED [OK]" : "INCOMPLETE [Need Forge Smite]"));

    // 4. Quest Slot 530 Inspection
    var slotVal = getQuestValue(530);
    log("-------------------------------------------------");
    log("[Check 4] Quest Slot 530 Current Value: " + slotVal);
    if (slotVal == 0) log("          -> Boulder quests not started yet.");
    else if (slotVal == 1) log("          -> Quest 9463 (Smite Boulder) completed.");
    else if (slotVal == 2) log("          -> Quest 9464 (Strike Boulder) completed.");
    else if (slotVal == 3) log("          -> Quest 9465 (Smash Boulder) completed. Ready for First-Time Gaol!");
    else if (slotVal >= 4) log("          -> Quest 9466 (Gaol First Clear) completed. Dungeon Reruns Unlocked!");
    log("-------------------------------------------------");

    // 5. Boulder Quests (9463, 9464, 9465)
    var q9463Done = hasBeenCompleted(9463);
    var q9463Avail = isQuestAvailable(9463);
    log("[Boulder 1] 9463 (Smite Boulder): Completed=" + q9463Done + " | Available=" + q9463Avail);

    var q9464Done = hasBeenCompleted(9464);
    var q9464Avail = isQuestAvailable(9464);
    log("[Boulder 2] 9464 (Strike Boulder): Completed=" + q9464Done + " | Available=" + q9464Avail);

    var q9465Done = hasBeenCompleted(9465);
    var q9465Avail = isQuestAvailable(9465);
    log("[Boulder 3] 9465 (Smash Boulder): Completed=" + q9465Done + " | Available=" + q9465Avail);

    // 6. Boulder Items Check
    log("-------------------------------------------------");
    var hasSmiteWeapon = hasItem("Weapon - Smite") || hasItem(70990);
    var hasAzalith = hasItem("Scythe of Azalith");
    var hasHammer = hasItem("J6's Hammer");
    log("[Item Check] Weapon - Smite: " + (hasSmiteWeapon ? "FOUND" : "MISSING (Buy in /forge shop 2142)"));
    log("[Item Check] Scythe of Azalith: " + (hasAzalith ? "FOUND" : "MISSING (Infernal Arena merge)"));
    log("[Item Check] J6's Hammer: " + (hasHammer ? "FOUND" : "MISSING (Buy in /hyperspace shop 194)"));
    log("-------------------------------------------------");

    // 7. Grimgaol Dungeon Quests Check
    var q9466Done = hasBeenCompleted(9466);
    var q9466Avail = isQuestAvailable(9466);
    log("[Gaol Quest] 9466 (First-Time Clear): Completed=" + q9466Done + " | Available=" + q9466Avail);

    var q9467Avail = isQuestAvailable(9467);
    log("[Gaol Quest] 9467 (Gaol Rerun): Available=" + q9467Avail);

    var q9468Avail = isQuestAvailable(9468);
    log("[Gaol Quest] 9468 (Gaol Rerun Legend): Available=" + q9468Avail);

    var q9469Avail = isQuestAvailable(9469);
    var q9469Daily = isDailyComplete(9469);
    log("[Gaol Quest] 9469 (Beat Up Master Daily): Available=" + q9469Avail + " | Completed Today=" + q9469Daily);

    // 8. Final Verdict & Next Action
    log("=================================================");
    log("               ACTIONABLE VERDICT                ");
    log("=================================================");
    if (!levelOk) {
        log("ACTION: Level up to 80 before attempting Grimgaol.");
    } else if (!dvbDone) {
        log("ACTION: Complete the DoomVaultB storyline (Quest 3004).");
    } else if (!smiteDone) {
        log("ACTION: Unlock the Forge Smite enhancement (Quest 8740).");
    } else if (slotVal < 3) {
        log("ACTION: You must complete the Boulder quests in /gaolcell!");
        if (slotVal == 0) log("        Next Quest to complete: 9463 ('Smite the Boulder!')");
        else if (slotVal == 1) log("        Next Quest to complete: 9464 ('Strike the Boulder!')");
        else if (slotVal == 2) log("        Next Quest to complete: 9465 ('Smash the Boulder!')");
    } else if (!q9466Done) {
        log("ACTION: Boulder cleared! You are ready for your FIRST Grimgaol run!");
        log("        The bot will accept Quest 9466 ('The Gaol of Eternal Torment and Misery').");
    } else {
        log("ACTION: Grimgaol is fully unlocked! The bot will accept:");
        log("        - Quest 9467 (or 9468 if Member)");
        if (!q9469Daily) log("        - Quest 9469 (Daily)");
    }
    log("=================================================");

    stop();
}

function onTick() {}

