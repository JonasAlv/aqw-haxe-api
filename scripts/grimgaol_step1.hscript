// Grimgaol Step 1: Join Map, Skip Cutscene, and Accept Quests
// Dedicated debug script to test map entry, cutscene bypass, and quest negotiation step-by-step.

var dailyQuestId = 9469;
var dungeonQuests = [9467, 9466, 9468];

var state = 0;
var stateTimer = 0;
var retryCount = 0;
var acceptedAnyDungeonQuest = false;

function onStart() {
    log("==========================================");
    log("[Step 1] Grimgaol Debug Script Initialized");
    log("==========================================");
    state = 0;
    stateTimer = 0;
    retryCount = 0;
    acceptedAnyDungeonQuest = false;
}

function onStop() {
    log("[Step 1] Script Stopped.");
}

function onTick() {
    // ----------------------------------------------------
    // STATE 0: Check Current Map & Queue into Grimgaol
    // ----------------------------------------------------
    if (state == 0) {
        if (!map.isLoaded) {
            log("[Step 1] Waiting for initial map to load...");
            sleep(500);
            return;
        }

        var mapName = map.name.toLowerCase();
        log("[Step 1] Current map: " + mapName + " | Cell: " + player.cell);

        if (mapName != "grimgaol") {
            log("[Step 1] Queueing for Grimgaol dungeon instance...");
            dungeonQueue("grimgaol");
            state = 1;
            stateTimer = 0;
            sleep(2000);
            return;
        } else {
            var living = getLivingMonstersInCell("Enter");
            if (living.length == 0) {
                log("[Step 1] Current Grimgaol instance is empty/cleared. Jumping to battleon to allow fresh queue...");
                join("battleon");
                sleep(1500);
                return;
            }
            log("[Step 1] Inside active Grimgaol with living monsters!");
            state = 2;
            sleep(300);
            return;
        }
    }

    // ----------------------------------------------------
    // STATE 1: Waiting for Grimgaol to finish loading
    // ----------------------------------------------------
    if (state == 1) {
        stateTimer = stateTimer + 1;
        if (map.isLoaded && map.name.toLowerCase() == "grimgaol") {
            log("[Step 1] Successfully loaded into Grimgaol! Current cell: " + player.cell);
            state = 2;
            stateTimer = 0;
            sleep(500);
            return;
        }

        if (stateTimer > 25) { // ~2.5s elapsed without entering
            log("[Step 1] Retrying dungeon queue...");
            dungeonQueue("grimgaol");
            stateTimer = 0;
            sleep(2000);
        } else {
            sleep(200);
        }
        return;
    }

    // ----------------------------------------------------
    // STATE 2: Handle & Skip Cutscene, Jump to Enter
    // ----------------------------------------------------
    if (state == 2) {
        log("[Step 1] Clearing cutscenes and popup modals...");
        skipCutscene();

        var cellLower = player.cell.toLowerCase();
        log("[Step 1] Player cell: " + player.cell);

        if (cellLower.indexOf("cut") != -1 || player.cell != "Enter") {
            log("[Step 1] Cell is '" + player.cell + "', jumping to Enter / Spawn...");
            jump("Enter", "Spawn");
            sleep(800);
            return;
        }

        if (player.cell == "Enter") {
            log("[Step 1] Player confirmed in 'Enter' cell! Cutscene skipped.");
            state = 3;
            stateTimer = 0;
            sleep(500);
            return;
        } else {
            skipCutscene();
            jump("Enter", "Spawn");
            sleep(500);
            return;
        }
    }

    // ----------------------------------------------------
    // STATE 3: Batch Load Quest Data from Server (UI-less)
    // ----------------------------------------------------
    if (state == 3) {
        log("[Step 1] Loading quest metadata into memory (loadQuests, no UI popup)...");

        var allQuests = [dailyQuestId];
        for (q in dungeonQuests) allQuests.push(q);
        loadQuests(allQuests);

        state = 4;
        stateTimer = 0;
        sleep(600);
        return;
    }

    // ----------------------------------------------------
    // STATE 4: Verify Quest Metadata Loaded in questTree
    // ----------------------------------------------------
    if (state == 4) {
        stateTimer = stateTimer + 1;
        var dailyLoaded = isQuestLoaded(dailyQuestId);
        log("[Step 1] Daily Quest (" + dailyQuestId + ") loaded in memory: " + dailyLoaded);

        var loadedDungeonCount = 0;
        for (q in dungeonQuests) {
            var qLoaded = isQuestLoaded(q);
            log("[Step 1] Dungeon Quest (" + q + ") loaded in memory: " + qLoaded);
            if (qLoaded) loadedDungeonCount = loadedDungeonCount + 1;
        }

        if (dailyLoaded || loadedDungeonCount > 0 || stateTimer >= 8) {
            log("[Step 1] Quest metadata ready! Dismissing quest popups and accepting...");
            skipCutscene();
            state = 5;
            stateTimer = 0;
            retryCount = 0;
            sleep(400);
            return;
        } else {
            sleep(400);
            return;
        }
    }

    // ----------------------------------------------------
    // STATE 5: Send Quest Accept Requests
    // ----------------------------------------------------
    if (state == 5) {
        retryCount = retryCount + 1;
        log("[Step 1] Determining available quests (Attempt " + retryCount + ")...");

        var slotVal = getQuestValue(530);
        var firstTimeCleared = hasBeenCompleted(9466) || slotVal >= 4;
        log("[Step 1] Slot 530 value: " + slotVal + " | First time cleared: " + firstTimeCleared);

        if (!firstTimeCleared) {
            if (isQuestAvailable(9466)) {
                log("[Step 1] Accepting First-Time Quest 9466...");
                acceptQuest(9466);
            } else {
                log("[Step 1] WARNING: Quest 9466 is NOT available yet! Prerequisite boulder quests missing.");
            }
        } else {
            var rerunId = 9467;
            if (isQuestAvailable(9468)) rerunId = 9468;
            if (isQuestAvailable(rerunId)) {
                log("[Step 1] Accepting Gaol Rerun Quest " + rerunId + "...");
                acceptQuest(rerunId);
            }

            if (!isDailyComplete(dailyQuestId) && isQuestAvailable(dailyQuestId)) {
                log("[Step 1] Accepting Daily Quest " + dailyQuestId + "...");
                acceptQuest(dailyQuestId);
            }
        }

        state = 6;
        stateTimer = 0;
        sleep(1000);
        return;
    }

    // ----------------------------------------------------
    // STATE 6: Verify Server Acceptance
    // ----------------------------------------------------
    if (state == 6) {
        stateTimer = stateTimer + 1;
        var slotVal = getQuestValue(530);
        var firstTimeCleared = hasBeenCompleted(9466) || slotVal >= 4;

        if (!firstTimeCleared) {
            var q9466Acc = isQuestAccepted(9466);
            log("[Step 1] Server Confirmation -> First-Time Quest (9466): " + (q9466Acc ? "ACCEPTED" : "NOT ACCEPTED"));
            if (q9466Acc) {
                log("[Step 1] SUCCESS: First-time Grimgaol quest successfully accepted!");
                state = 7;
                sleep(400);
                return;
            }
        } else {
            var dailyAcc = isQuestAccepted(dailyQuestId);
            var rerun7Acc = isQuestAccepted(9467);
            var rerun8Acc = isQuestAccepted(9468);
            log("[Step 1] Server Confirmation -> Daily (9469): " + (dailyAcc ? "ACCEPTED" : "NOT ACCEPTED"));
            log("[Step 1] Server Confirmation -> Rerun (9467): " + (rerun7Acc ? "ACCEPTED" : "NOT ACCEPTED"));
            log("[Step 1] Server Confirmation -> Rerun Legend (9468): " + (rerun8Acc ? "ACCEPTED" : "NOT ACCEPTED"));
            if (rerun7Acc || rerun8Acc) {
                log("[Step 1] SUCCESS: Gaol rerun quest successfully accepted!");
                state = 7;
                sleep(400);
                return;
            }
        }

        if (retryCount < 3) {
            state = 5;
            sleep(1000);
            return;
        } else {
            log("[Step 1] Finished quest acceptance sequence. Quests may be locked if prerequisites are not met.");
            state = 7;
            sleep(400);
            return;
        }
    }

    // ----------------------------------------------------
    // STATE 7: Final Step 1 Verification & Summary
    // ----------------------------------------------------
    if (state == 7) {
        // Clear any lingering quest popup dialogs
        skipCutscene();

        log("==========================================");
        log("[Step 1] === VERIFICATION RESULTS ===");
        log("Map: " + map.name + " | Cell: " + player.cell + " | Pad: " + player.pad);
        log("Player State: " + (player.isAlive ? "Alive" : "Dead") + " (HP: " + player.hp + "/" + player.maxHp + ")");
        log("First-Time Clear (9466): " + (isQuestAccepted(9466) ? "[ACCEPTED]" : "[NOT ACCEPTED]"));
        log("Rerun Quest (9467): " + (isQuestAccepted(9467) ? "[ACCEPTED]" : "[NOT ACCEPTED]"));
        log("Rerun Legend (9468): " + (isQuestAccepted(9468) ? "[ACCEPTED]" : "[NOT ACCEPTED]"));
        log("Daily Quest (9469): " + (isQuestAccepted(dailyQuestId) ? "[ACCEPTED]" : "[NOT ACCEPTED]"));
        log("==========================================");
        log("[Step 1] COMPLETE! Ready for combat debug.");
        stop();
        return;
    }
}

