// Four Harbingers - Halosis Boss Script
// Faithfully ported from Skua's Halosis.cs (FourHarbingers_Halosis)

var questId = 10850;
var targetDrop = "Signet of Inner Conflict";
var bossMap = "fourharbingers";
var bossCell = "r2";
var bossPad = "Bottom";

var allDrops = [
    "Celestial Winged Manticore",
    "Manticore of Light",
    "Scroll of the Quartet",
    "Scroll of the Wanderer",
    "Signet of Inner Conflict"
];

var selectedClass = "Dragon of Time";
var dieNowDetected = false;
var dieNowDetectedAt = 0.0;
var dieNowHandled = false;
var skillOneReserved = false;
var autoAttackCancelled = false;

function onStart() {
    log("Starting Halosis runner (faithful to Skua Halosis.cs)...");
    acceptQuest(questId);

    // Equip class: prefers Dragon of Time, falls back to Chaos Avenger
    if (hasItem("Dragon of Time")) {
        selectedClass = "Dragon of Time";
        equip("Dragon of Time");
    } else if (hasItem("Chaos Avenger")) {
        selectedClass = "Chaos Avenger";
        equip("Chaos Avenger");
    }

    log("Selected class: " + selectedClass);

    join(bossMap, bossCell, bossPad);
    startNormalSkills();
}

function startNormalSkills() {
    if (selectedClass == "Dragon of Time") {
        // Skua: ReplaceSkillProvider("3 | 2 | 1 | 2 | 4 | 2", 250, SkillUseMode.WaitForCooldown)
        combat.startCustom("3,2,1,2,4,2");
    } else {
        // Skua: ReplaceSkillProvider("3 | 4 | 2 | 1")
        combat.startCustom("3,4,2,1");
    }
}

function onTick() {
    // 1. Player death check
    if (!player.isAlive) {
        log("Player dead, waiting for respawn...");
        dieNowDetected = false;
        dieNowDetectedAt = 0.0;
        skillOneReserved = false;
        autoAttackCancelled = false;
        dieNowHandled = false;
        sleep(2000);
        return;
    }

    // 2. Map check
    if (map.name.toLowerCase() != bossMap) {
        join(bossMap, bossCell, bossPad);
        sleep(2000);
        return;
    }

    // 3. Cell check
    if (player.cell != bossCell) {
        jump(bossCell, bossPad);
        sleep(500);
        return;
    }

    // 4. Quest turn-in / drop completion check
    if (hasItem(targetDrop)) {
        log("Obtained " + targetDrop + "! Turning in quest " + questId);
        completeQuest(questId);
        for (d in allDrops) getDrop(d);
        sleep(1000);
        return;
    }

    // 5. Target check (acquire Halosis)
    if (player.target == null || !player.target.alive) {
        combat.attack("Halosis");
        sleep(300);
        return;
    }

    // 6. Class Mechanics (faithful to Skua Halosis.cs)
    // Note: In the original Halosis.cs, Dragon of Time does NOT stop for Crits Inverted or Die Now!
    // Dragon of Time's DoT damage cannot crit and its massive HP pool and healing sustain through it.
    // Chaos Avenger is the only class that executes ChaosAvengerMechanics().
    if (selectedClass == "Chaos Avenger") {
        chaosAvengerMechanics();
    } else {
        // Dragon of Time: simply ensure rotation is always running
        if (!combat.isAutoRunning) {
            startNormalSkills();
        }
    }

    // 7. Collect drops
    for (d in allDrops) getDrop(d);
}

function chaosAvengerMechanics() {
    // A. Crits Inverted: pause skills and cancel auto-attack
    if (player.hasAura("Crits Inverted")) {
        if (combat.isAutoRunning) {
            log("Crits Inverted detected! Pausing attack.");
            combat.stopAuto();
        }
        autoAttackCancelled = true;
        cancelAutoAttack();
        return;
    }

    // B. Die Now survival mechanic
    if (dieNowDetected && !dieNowHandled) {
        var elapsed = AqwTime.now() - dieNowDetectedAt;
        if (combat.isAutoRunning) combat.stopAuto();

        if (autoAttackCancelled) {
            autoAttackCancelled = false;
            combat.attack("Halosis");
        }

        // Wait 2000ms, then use Skill 1
        if (elapsed >= 2000 && canUseSkill(1)) {
            log("Executing Chaos Avenger Skill 1 against Die Now!");
            useSkill(1);
            dieNowDetected = false;
            dieNowDetectedAt = 0.0;
            skillOneReserved = false;
            dieNowHandled = true;
            startNormalSkills();
        }
        return;
    }

    // Re-engage auto-attack if it was cancelled
    if (autoAttackCancelled) {
        autoAttackCancelled = false;
        combat.attack("Halosis");
    }

    // Resume normal skills if not running
    if (!combat.isAutoRunning) {
        startNormalSkills();
    }

    // C. Reserve Skill 1 below 40% HP
    var target = player.target;
    if (!skillOneReserved && !dieNowHandled && target != null) {
        if (target.maxHp > 0 && target.hp > 0 && (target.hp * 100 <= target.maxHp * 40)) {
            skillOneReserved = true;
            combat.startCustom("3,4,2");
            log("Halosis reached 40% HP. Skill 1 is now reserved for Die now.");
        }
    }
}

function onPacket(type, cmd, data) {
    if (type != "json" || data == null) return;

    // Listen for "Die now." animation message (Skua HalosisFlashListener)
    if (data.cmd == "ct" && data.anims != null) {
        var anims = data.anims;
        if (Std.isOfType(anims, Array)) {
            for (anim in (cast anims : Array<Dynamic>)) {
                if (anim != null && anim.msg != null) {
                    var msg = Std.string(anim.msg);
                    if (msg == "Die now." || msg == "Die now") {
                        if (dieNowHandled || dieNowDetected) return;
                        log("Die now detected! Skill 1 will be used after 2 seconds.");
                        dieNowDetected = true;
                        dieNowDetectedAt = AqwTime.now();
                        if (combat.isAutoRunning) combat.stopAuto();
                        return;
                    }
                }
            }
        }
    }
}

function onStop() {
    log("Halosis runner stopped.");
    combat.stopAuto();
    dropCombat();
}
