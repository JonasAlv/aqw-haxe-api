// Grimgaol Step 2: Room 1 (Enter) Combat Debug
// Tests monster target acquisition, class skill rotation, Talon Twisting pause, and Contrarium guard in Room 1.

var dailyQuestId = 9469;
var dungeonQuests = [9467, 9466, 9468];

var currentClass = "Generic";
var rotationIndex = 0;
var grimskullEngaged = false;
var grimskullDefeated = false;

function onStart() {
    log("==========================================");
    log("[Step 2] Grimgaol Room 1 Combat Debug Initialized");
    log("==========================================");
    grimskullEngaged = false;
    grimskullDefeated = false;
    rotationIndex = 0;

    // Detect and select loadout (King's Echo is #1 priority)
    if (hasItem("King's Echo")) {
        currentClass = "King's Echo";
        equip("King's Echo");
    } else if (hasItem("Dragon of Time")) {
        currentClass = "Dragon of Time";
        equip("Dragon of Time");
    } else if (hasItem("Legion Revenant")) {
        currentClass = "Legion Revenant";
        equip("Legion Revenant");
    } else if (hasItem("ArchPaladin")) {
        currentClass = "ArchPaladin";
        equip("ArchPaladin");
    } else {
        currentClass = "Generic";
    }
    log("[Step 2] Class selected: " + currentClass);
    setInfiniteRange(true);
}

function onStop() {
    log("[Step 2] Script Stopped.");
    setInfiniteRange(false);
    dropCombat();
}

function onTick() {
    if (!map.isLoaded) {
        sleep(500);
        return;
    }

    skipCutscene();

    // 1. Ensure inside Grimgaol at Enter
    if (map.name.toLowerCase() != "grimgaol") {
        log("[Step 2] Not in Grimgaol. Queueing fresh dungeon instance...");
        dungeonQueue("grimgaol");
        sleep(2000);
        return;
    }

    var currentCell = player.cell;

    if (currentCell != "Enter" && currentCell != "r2") {
        log("[Step 2] Cell is '" + currentCell + "', jumping to Enter...");
        jump("Enter", "Spawn");
        sleep(800);
        return;
    }

    // 2. Ensure quests are loaded and accepted
    var slotVal = getQuestValue(530);
    var firstTimeCleared = hasBeenCompleted(9466) || slotVal >= 4;

    if (!firstTimeCleared) {
        if (!isQuestAccepted(9466) && isQuestAvailable(9466)) {
            acceptQuest(9466);
        }
    } else {
        var rerunId = 9467;
        if (isQuestAvailable(9468)) rerunId = 9468;
        if (!isQuestAccepted(rerunId) && isQuestAvailable(rerunId)) {
            acceptQuest(rerunId);
        }
        if (!isDailyComplete(dailyQuestId) && !isQuestAccepted(dailyQuestId) && isQuestAvailable(dailyQuestId)) {
            acceptQuest(dailyQuestId);
        }
    }

    // 3. Room 1 & 2 Advancement and Completion Check
    if (currentCell == "Enter") {
        var enterMonsters = getLivingMonstersInCell("Enter");
        if (enterMonsters.length == 0) {
            if (grimskullEngaged && !grimskullDefeated) {
                grimskullDefeated = true;
                log("==========================================");
                log("[Step 2] SUCCESS! Grimskull defeated in Enter!");
                log("[Step 2] Room 1 is 100% clear! Advancing to Room 2 (r2)...");
                log("==========================================");
                jump("r2", "Left");
                sleep(1000);
                return;
            } else if (!grimskullEngaged && !grimskullDefeated) {
                log("[Step 2] Enter cell is empty (instance was already cleared).");
                log("[Step 2] Jumping to Battleon to queue a fresh Grimgaol run...");
                join("battleon");
                sleep(1500);
                return;
            } else if (grimskullDefeated) {
                log("[Step 2] Room 1 already cleared. Advancing to r2...");
                jump("r2", "Left");
                sleep(1000);
                return;
            }
        }
    } else if (currentCell == "r2") {
        var r2Monsters = getLivingMonstersInCell("r2");
        if (r2Monsters.length == 0) {
            log("==========================================");
            log("[Step 2] SUCCESS! Grim Bomb defeated in Room 2 (r2)!");
            log("[Step 2] Room 1 and Room 2 100% complete!");
            log("[Step 2] Debug verified! Use 'grimgaol.hscript' for full 12-cell runner.");
            log("==========================================");
            jump("r3", "Left");
            stop();
            return;
        }
    }

    var monstersInCell = getLivingMonstersInCell(currentCell);
    if (monstersInCell.length == 0) {
        sleep(300);
        return;
    }

    var targetMon = monstersInCell[0];

    // 4. Boss Mechanic: Talon Twisting (100% Reflect Shield in Enter)
    var hasTalon = (targetMon != null && targetMon.hasAura("Talon Twisting")) || hasTargetAura("Talon Twisting");
    var hasRetaliate = (targetMon != null && targetMon.hasAura("Retaliate")) || hasTargetAura("Retaliate");
    if (hasTalon && !hasRetaliate) {
        cancelAutoAttack();
        cancelTarget();
        log("[Step 2] REFLECT SHIELD (Talon Twisting) active! Combat paused until Retaliate...");
        sleep(1000);
        return;
    }

    // 5. Target Acquisition & Close Range Approach
    if (player.target == null || !player.target.alive) {
        log("[Step 2] Target acquired: " + targetMon.name + " (MapID: " + targetMon.mapId + ", HP: " + targetMon.hp + ")");
        attack(targetMon.mapId);
        approach();
        if (currentCell == "Enter") grimskullEngaged = true;
        sleep(250);
        return;
    }

    // 6. Boss Mechanic: Contrarium (Heal Inversion)
    var hasContrarium = hasPlayerAura("Contrarium");

    // 7. Fire class skills
    var rot = [1, 2, 3, 4];
    if (currentClass == "Dragon of Time") {
        rot = [3, 2, 1, 2, 4, 2];
    } else if (currentClass == "Legion Revenant") {
        rot = [3, 4, 1, 2];
    } else if (currentClass == "King's Echo") {
        rot = [1, 2];
    }

    // King's Echo specific utility:
    if (currentClass == "King's Echo") {
        if (player.mp <= player.maxMp * 0.25 && canUseSkill(4)) {
            useSkill(4);
            sleep(200);
            return;
        }
        if (player.hp <= player.maxHp * 0.65 && !hasContrarium && canUseSkill(3)) {
            useSkill(3);
            sleep(200);
            return;
        }
    }

    var skill = rot[rotationIndex];

    // Contrarium protection: skip healing skill (skill 2 for DoT, skill 3 for KE/AP)
    if (hasContrarium && (skill == 2 || skill == 3)) {
        rotationIndex = (rotationIndex + 1) % rot.length;
        skill = rot[rotationIndex];
    }

    if (canUseSkill(skill)) {
        useSkill(skill);
        rotationIndex = (rotationIndex + 1) % rot.length;
    }

    sleep(200);
}
