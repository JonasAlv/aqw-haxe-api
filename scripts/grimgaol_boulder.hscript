// Grimgaol Boulder Questline Automator
// Completes Quests 9463, 9464, and 9465 in /gaolcell to unlock Grimgaol dungeon!

var step = 0;
var timer = 0;

function onStart() {
    log("==========================================");
    log("  GRIMGAOL BOULDER QUEST AUTOMATOR        ");
    log("==========================================");
    loadQuests([9463, 9464, 9465]);
    step = 0;
    timer = 0;
}

function onStop() {
    log("Boulder script stopped.");
}

function onTick() {
    if (!map.isLoaded) {
        sleep(500);
        return;
    }

    skipCutscene();

    var slotVal = getQuestValue(530);

    // If slot 530 is >= 3, boulder quests are finished!
    if (slotVal >= 3) {
        log("[Boulder] Slot 530 value is " + slotVal + " -> All 3 Boulder quests are COMPLETE!");
        log("[Boulder] Grimgaol dungeon Quest 9466 is now UNLOCKED!");
        stop();
        return;
    }

    // Ensure we are in gaolcell
    if (map.name.toLowerCase() != "gaolcell") {
        log("[Boulder] Joining /gaolcell...");
        join("gaolcell");
        sleep(2000);
        return;
    }

    // --- Quest 9463: Smite the Boulder! ---
    if (slotVal == 0) {
        if (!hasItem("Weapon - Smite") && !hasItem(70990)) {
            log("[Boulder] Buying 'Weapon - Smite' from Forge shop (2142)...");
            shop.loadShop(2142);
            sleep(1000);
            shop.buyItem("Weapon - Smite");
            sleep(1000);
            if (!hasItem("Weapon - Smite") && !hasItem(70990)) {
                log("[Boulder] ERROR: Missing 'Weapon - Smite'. Make sure you unlocked Forge Smite (Quest 8740)!");
                stop();
                return;
            }
        }

        if (!isQuestAccepted(9463)) {
            log("[Boulder] Accepting Quest 9463 (Smite the Boulder!)...");
            acceptQuest(9463);
            sleep(1000);
            return;
        }

        log("[Boulder] Smashing Boulder with Smite (Map Item 12327)...");
        getMapItem(12327);
        sleep(1500);

        log("[Boulder] Completing Quest 9463...");
        completeQuest(9463);
        sleep(2000);
        return;
    }

    // --- Quest 9464: Strike the Boulder! ---
    if (slotVal == 1) {
        if (!hasItem("Scythe of Azalith")) {
            log("[Boulder] ERROR: Missing 'Scythe of Azalith' in inventory/bank.");
            log("[Boulder] Acquire 'Scythe of Azalith' from Infernal Arena merge, then restart.");
            stop();
            return;
        }

        if (!isQuestAccepted(9464)) {
            log("[Boulder] Accepting Quest 9464 (Strike the Boulder!)...");
            acceptQuest(9464);
            sleep(1000);
            return;
        }

        log("[Boulder] Striking Boulder with Scythe of Azalith (Map Item 12328)...");
        getMapItem(12328);
        sleep(1500);

        log("[Boulder] Completing Quest 9464...");
        completeQuest(9464);
        sleep(2000);
        return;
    }

    // --- Quest 9465: Smash the Boulder! ---
    if (slotVal == 2) {
        if (!hasItem("J6's Hammer")) {
            log("[Boulder] Trying to buy 'J6's Hammer' from Hyperspace shop (194)...");
            shop.loadShop(194);
            sleep(1000);
            shop.buyItem("J6's Hammer");
            sleep(1000);
            if (!hasItem("J6's Hammer")) {
                log("[Boulder] ERROR: Missing 'J6's Hammer'. Make sure J6 storyline is completed!");
                stop();
                return;
            }
        }

        if (!isQuestAccepted(9465)) {
            log("[Boulder] Accepting Quest 9465 (Smash the Boulder!)...");
            acceptQuest(9465);
            sleep(1000);
            return;
        }

        log("[Boulder] Smashing Boulder with J6's Hammer (Map Item 12329)...");
        getMapItem(12329);
        sleep(1500);

        log("[Boulder] Completing Quest 9465...");
        completeQuest(9465);
        sleep(2000);
        return;
    }
}

